{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grapholog:workspace-config:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "grapholog.workspace-config.v1"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "schema",
    "projects"
  ],
  "additionalProperties": false
}
