# Grapholog canonical JSON; always apply JSON Schema and reference validation.
root ::= rule-30 ws
rule-1 ::= "\"" char{0,256} "\""
rule-2 ::= "\"" char{0,256} "\""
rule-3 ::= "\"succeeded\"" | "\"needs_review\""
rule-4 ::= "\"" char{1,1000} "\""
rule-5 ::= "\"" char{0,256} "\""
rule-6 ::= "{" ws "\"path\"" ws ":" ws rule-4 ws "," ws "\"sha256\"" ws ":" ws rule-5 ws "}"
rule-7 ::= "[" ws rule-6 (ws "," ws rule-6){0,99} ws "]"
rule-8 ::= "\"" char{1,240} "\""
rule-9 ::= "\"" char{1,1000} "\""
rule-10 ::= "\"" char{0,256} "\""
rule-11 ::= "{" ws "\"path\"" ws ":" ws rule-9 ws "," ws "\"sha256\"" ws ":" ws rule-10 ws "}"
rule-12 ::= "{" ws "\"name\"" ws ":" ws rule-8 ws "," ws "\"passed\"" ws ":" ws ("true" | "false") ws "," ws "\"evidence\"" ws ":" ws rule-11 ws "}"
rule-13 ::= "[" ws (rule-12 (ws "," ws rule-12){0,99})? ws "]"
rule-14 ::= "\"" char{1,240} "\""
rule-15 ::= "\"" char{1,240} "\""
rule-16 ::= "\"package\"" | "\"artifact\""
rule-17 ::= "\"" char{1,240} "\""
rule-18 ::= "\"" char{1,240} "\""
rule-19 ::= "\"" char{1,240} "\""
rule-20 ::= "{" ws "\"family_id\"" ws ":" ws rule-17 ws "," ws "\"import_path\"" ws ":" ws rule-18 ws "," ws "\"symbol\"" ws ":" ws rule-19 ws "}"
rule-21 ::= "[" ws (rule-20 (ws "," ws rule-20){0,999})? ws "]"
rule-22 ::= "{" ws "\"name\"" ws ":" ws rule-14 ws "," ws "\"version\"" ws ":" ws rule-15 ws "," ws "\"kind\"" ws ":" ws rule-16 ws "," ws "\"exports\"" ws ":" ws rule-21 ws "}"
rule-23 ::= "\"compatible\"" | "\"needs_review\""
rule-24 ::= "\"" char{1,1000} "\""
rule-25 ::= "\"" char{0,256} "\""
rule-26 ::= "{" ws "\"path\"" ws ":" ws rule-24 ws "," ws "\"sha256\"" ws ":" ws rule-25 ws "}"
rule-27 ::= "{" ws "\"status\"" ws ":" ws rule-23 ws "," ws "\"evidence\"" ws ":" ws rule-26 ws "}"
rule-28 ::= "\"" char{0,4000} "\""
rule-29 ::= "[" ws (rule-28 (ws "," ws rule-28){0,29})? ws "]"
rule-30 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.task-result.v1\"" ws "," ws "\"task_key\"" ws ":" ws rule-1 ws "," ws "\"input_digest\"" ws ":" ws rule-2 ws "," ws "\"outcome\"" ws ":" ws rule-3 ws "," ws "\"artifacts\"" ws ":" ws rule-7 ws "," ws "\"tests\"" ws ":" ws rule-13 ws "," ws "\"package\"" ws ":" ws rule-22 ws "," ws "\"license_review\"" ws ":" ws rule-27 ws "," ws "\"notes\"" ws ":" ws rule-29 ws "}"
ws ::= [ \t\n\r]*
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
uint ::= "0" | [1-9] [0-9]{0,9}
confidence ::= "0" ("." [0-9]{1,8})? | "1" ("." "0"{1,8})?
