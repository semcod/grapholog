{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grapholog:ticket-proposal:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "planfile.ticket-proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "name": {
      "type": "string",
      "maxLength": 4000
    },
    "description": {
      "type": "string",
      "maxLength": 100000
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "tool": {
          "const": "grapholog"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "finding_id",
        "artifact_digest"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "maxItems": 30
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 10000
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "maxItems": 30
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "maxItems": 10000
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "dedupe_key",
    "name",
    "description",
    "priority",
    "source",
    "labels",
    "files",
    "acceptance_criteria",
    "evidence_refs"
  ]
}
