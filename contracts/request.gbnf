# Grapholog canonical JSON; always apply JSON Schema and reference validation.
root ::= rule-59 ws
rule-1 ::= "{" ws  ws "}"
rule-2 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"summary\"" ws "," ws "\"params\"" ws ":" ws rule-1 ws "}"
rule-3 ::= "{" ws "\"offset\"" ws ":" ws uint ws "," ws "\"limit\"" ws ":" ws uint ws "}"
rule-4 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"projects\"" ws "," ws "\"params\"" ws ":" ws rule-3 ws "}"
rule-5 ::= "\"\"" | "\"function-body\"" | "\"function-shape\""
rule-6 ::= "\"" char{0,32} "\""
rule-7 ::= "\"" char{0,240} "\""
rule-8 ::= "{" ws "\"offset\"" ws ":" ws uint ws "," ws "\"limit\"" ws ":" ws uint ws "," ws "\"cross_project\"" ws ":" ws ("true" | "false") ws "," ws "\"match\"" ws ":" ws rule-5 ws "," ws "\"language\"" ws ":" ws rule-6 ws "," ws "\"project_id\"" ws ":" ws rule-7 ws "}"
rule-9 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"clones\"" ws "," ws "\"params\"" ws ":" ws rule-8 ws "}"
rule-10 ::= "\"" char{0,256} "\""
rule-11 ::= "\"" char{0,240} "\""
rule-12 ::= "{" ws "\"offset\"" ws ":" ws uint ws "," ws "\"limit\"" ws ":" ws uint ws "," ws "\"group_id\"" ws ":" ws rule-10 ws "," ws "\"project_id\"" ws ":" ws rule-11 ws "}"
rule-13 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"members\"" ws "," ws "\"params\"" ws ":" ws rule-12 ws "}"
rule-14 ::= "\"" char{0,240} "\""
rule-15 ::= "\"\"" | "\"project\"" | "\"file\"" | "\"symbol\"" | "\"external\"" | "\"clone_group\""
rule-16 ::= "\"" char{0,200} "\""
rule-17 ::= "{" ws "\"offset\"" ws ":" ws uint ws "," ws "\"limit\"" ws ":" ws uint ws "," ws "\"project_id\"" ws ":" ws rule-14 ws "," ws "\"kind\"" ws ":" ws rule-15 ws "," ws "\"search\"" ws ":" ws rule-16 ws "}"
rule-18 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"nodes\"" ws "," ws "\"params\"" ws ":" ws rule-17 ws "}"
rule-19 ::= "\"" char{0,256} "\""
rule-20 ::= "\"both\"" | "\"in\"" | "\"out\""
rule-21 ::= "\"\"" | "\"contains\"" | "\"calls\"" | "\"imports\"" | "\"clone_member\""
rule-22 ::= "{" ws "\"offset\"" ws ":" ws uint ws "," ws "\"limit\"" ws ":" ws uint ws "," ws "\"node_id\"" ws ":" ws rule-19 ws "," ws "\"direction\"" ws ":" ws rule-20 ws "," ws "\"kind\"" ws ":" ws rule-21 ws "}"
rule-23 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"neighbors\"" ws "," ws "\"params\"" ws ":" ws rule-22 ws "}"
rule-24 ::= "\"" char{0,240} "\""
rule-25 ::= "{" ws "\"offset\"" ws ":" ws uint ws "," ws "\"limit\"" ws ":" ws uint ws "," ws "\"project_id\"" ws ":" ws rule-24 ws "}"
rule-26 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"exclusions\"" ws "," ws "\"params\"" ws ":" ws rule-25 ws "}"
rule-27 ::= "\"" char{0,256} "\""
rule-28 ::= "{" ws "\"node_id\"" ws ":" ws rule-27 ws "," ws "\"include_source\"" ws ":" ws ("true" | "false") ws "," ws "\"max_source_chars\"" ws ":" ws uint ws "}"
rule-29 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"evidence\"" ws "," ws "\"params\"" ws ":" ws rule-28 ws "}"
rule-30 ::= "\"" char{0,256} "\""
rule-31 ::= "[" ws rule-30 (ws "," ws rule-30){0,9} ws "]"
rule-32 ::= "{" ws "\"group_ids\"" ws ":" ws rule-31 ws "," ws "\"max_chars\"" ws ":" ws uint ws "," ws "\"max_members\"" ws ":" ws uint ws "," ws "\"include_source\"" ws ":" ws ("true" | "false") ws "}"
rule-33 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"context\"" ws "," ws "\"params\"" ws ":" ws rule-32 ws "}"
rule-34 ::= "\"" char{1,240} "\""
rule-35 ::= "\"" char{0,256} "\""
rule-36 ::= "\"" char{1,240} "\""
rule-37 ::= "\"" char{1,1000} "\""
rule-38 ::= "\"" char{0,256} "\""
rule-39 ::= "\"" char{1,240} "\""
rule-40 ::= "\"" char{1,240} "\""
rule-41 ::= "\"" char{1,1000} "\""
rule-42 ::= "\"python\"" | "\"javascript\"" | "\"typescript\"" | "\"tsx\"" | "\"php\"" | "\"bash\""
rule-43 ::= "\"package\"" | "\"artifact\""
rule-44 ::= "{" ws "\"id\"" ws ":" ws rule-38 ws "," ws "\"name\"" ws ":" ws rule-39 ws "," ws "\"project\"" ws ":" ws rule-40 ws "," ws "\"path\"" ws ":" ws rule-41 ws "," ws "\"language\"" ws ":" ws rule-42 ws "," ws "\"kind\"" ws ":" ws rule-43 ws "}"
rule-45 ::= "[" ws (rule-44 (ws "," ws rule-44){0,999})? ws "]"
rule-46 ::= "\"" char{0,256} "\""
rule-47 ::= "\"python\"" | "\"javascript\"" | "\"typescript\"" | "\"tsx\"" | "\"php\"" | "\"bash\""
rule-48 ::= "\"" char{1,1000} "\""
rule-49 ::= "\"" char{1,240} "\""
rule-50 ::= "{" ws "\"package_id\"" ws ":" ws rule-46 ws "," ws "\"language\"" ws ":" ws rule-47 ws "," ws "\"path_glob\"" ws ":" ws rule-48 ws "," ws "\"symbol_glob\"" ws ":" ws rule-49 ws "}"
rule-51 ::= "[" ws (rule-50 (ws "," ws rule-50){0,999})? ws "]"
rule-52 ::= "\"" char{1,240} "\""
rule-53 ::= "\"" char{0,256} "\""
rule-54 ::= "{" ws "\"project\"" ws ":" ws rule-52 ws "," ws "\"github\"" ws ":" ws rule-53 ws "}"
rule-55 ::= "[" ws (rule-54 (ws "," ws rule-54){0,999})? ws "]"
rule-56 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.extraction-config.v1\"" ws "," ws "\"coordinator\"" ws ":" ws rule-34 ws "," ws "\"queue\"" ws ":" ws rule-35 ws "," ws "\"new_package_project\"" ws ":" ws rule-36 ws "," ws "\"new_package_directory\"" ws ":" ws rule-37 ws "," ws "\"include_tests\"" ws ":" ws ("true" | "false") ws "," ws "\"include_shape\"" ws ":" ws ("true" | "false") ws "," ws "\"max_groups\"" ws ":" ws uint ws "," ws "\"packages\"" ws ":" ws rule-45 ws "," ws "\"routes\"" ws ":" ws rule-51 ws "," ws "\"repositories\"" ws ":" ws rule-55 ws "}"
rule-57 ::= "{" ws "\"config\"" ws ":" ws rule-56 ws "}"
rule-58 ::= "{" ws "\"schema\"" ws ":" ws "\"grapholog.request.v1\"" ws "," ws "\"operation\"" ws ":" ws "\"extraction_plan\"" ws "," ws "\"params\"" ws ":" ws rule-57 ws "}"
rule-59 ::= rule-2 | rule-4 | rule-9 | rule-13 | rule-18 | rule-23 | rule-26 | rule-29 | rule-33 | rule-58
ws ::= [ \t\n\r]*
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
uint ::= "0" | [1-9] [0-9]{0,9}
confidence ::= "0" ("." [0-9]{1,8})? | "1" ("." "0"{1,8})?
